{
  "meta": {
    "name": "hatches",
    "description": "Self-hosted team workspace",
    "versioning": {
      "scheme": "[Release].[Patch]-[Stage].[Count][Tag]",
      "explained": "Format: 1.0.0-dev.1a = Major.Minor.Patch-Stage.CountStageTag. Stage order: pre (pre-release) → b (beta) → a (alpha) → dev (development) → (stable release). Examples: 0.0.0-pre.1, 0.0.1-b.1a, 0.1.0-a.1a, 1.0.0-dev.1a",
      "stages_order": ["pre", "b", "a", "dev"],
      "stages_meaning": {
        "pre": "Pre-release — earliest testing, unstable",
        "b": "Beta — feature set defined, bug fixing",
        "a": "Alpha — feature complete, hardening",
        "dev": "Dev — release candidate, stable-bound"
      }
    }
  },

  "releases": {
    "0.0.0-pre.1": {
      "status": "past",
      "description": "Initial pre-release"
    },

    "0.0.1-b.1a": {
      "status": "past",
      "description": "Beta build"
    },

    "0.1.0-a.1a": {
      "status": "past",
      "description": "Alpha build"
    },

    "1.0.0-dev.1a": {
      "status": "current",
      "description": "Current dev build — first stable-bound release"
    }
  },

  "roadmap": {
