{
  "meta": {
    "name": "hatches",
    "description": "Self-hosted team workspace",
    "versioning": {
      "scheme": "[Release].[Patch]-[Stage].[Count][Tag]",
      "explained": "Format: 1.0.0-dev.1a = Major.Minor.Patch-Stage.CountStageTag. Stage order: dev → b → a → pre → stable. Examples: 0.0.0-dev.1a, 0.0.0-b.1a, 0.0.0-a.1a, 0.0.0-pre.1, 1.0.0",
      "stages_order": ["dev", "b", "a", "pre"],
      "stages_meaning": {
        "dev": "Development — active development, unstable API",
        "b": "Beta — feature set defined, bug fixing",
        "a": "Alpha — feature complete, hardening",
        "pre": "Pre-release — near stable, final hardening"
      }
    }
  },

  "releases": {
