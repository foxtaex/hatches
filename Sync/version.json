{
  "meta": {
    "name": "hatches",
    "description": "Self-hosted team workspace",
    "versioning": {
      "scheme": "[Major].[Minor].[Patch].[Date]-[Stage].[Count][Tag]",
      "internal": "0.0.5.14.23-dev.4g = Major.Minor(Feature).Patch(Date)-Stage.CountTag",
      "display": "Simple format shown to users: 5.14-dev",
      "stage_order": ["dev", "a", "b", "pre"],
      "stage_meaning": {
        "dev": "Development",
        "a": "Alpha",
        "b": "Beta",
        "pre": "Pre-release"
      }
    }
  },

  "releases": {
    "5.14-dev": {
      "internal": "0.0.5.14.23-dev.4g",
      "status": "current",
      "description": "Base hatches — Kanban, Docs, Notes, Websites, Teams, Integrations",
      "features": [
        "Kanban Board (multi-board, drag & drop, cards, assignment)",
        "Docs (Markdown editor, live split-view preview)",
        "Notes (Quick personal notes)",
        "Websites (Internal URL & project registry)",
        "Teams & Roles (Permission system per section)",
        "Integrations (GitHub, GitLab, Jira, Redmine, MantisBT, Confluence, Trello)",
        "Auth (Session-based, password hashing)",
        "Setup Wizard (/setup on first visit)"
      ],
      "tech": [
        "Astro 6 (SSR) + React Islands",
        "TypeScript",
        "Tailwind CSS v4",
        "Prisma 7 (SQLite default, PostgreSQL, MySQL, MSSQL)",
        "dnd-kit (Drag & Drop)",
        "@uiw/react-md-editor (Markdown)"
      ]
    },

    "5.15-dev": {
      "internal": "0.0.5.15.XX-dev.Xg",
      "status": "planned",
      "description": "Stability + UX improvements",
      "features": [
        "Dark/Light theme toggle",
        "Markdown improvements (code syntax highlighting, tables)",
        "Search across Docs + Notes",
        "Keyboard shortcuts",
        "Performance optimizations"
      ],
      "tech": []
    },

    "6.0-dev": {
