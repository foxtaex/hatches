{
  "meta": {
    "name": "hatches",
    "description": "Self-hosted team workspace"
  },

  "versioning": {
    "internal": {
      "scheme": "[Major].[Minor].[Patch].[YYMMDD]-[Stage].[BugfixCount][MiniUpdateCount][WeekTag]",
      "example": "0.0.5.14.23-dev.4g",
      "parts": {
        "major": "Major Versionszähler",
        "minor": "Feature-Minor",
        "patch": "Patch-Level",
        "date": "Datum (YYMMDD)",
        "stage": "Stage (dev/a/b/pre/stable)",
        "bugfix": "Bugfix-Zähler an diesem Tag",
        "mini": "Mini-Update-Zähler",
        "weektag": "Wochentag (a-m = So-Sa = 0-6)"
      }
    },
    "display": {
      "scheme_dev": "[Major].[Minor].[YYMMDD]-[Stage].[BugfixCount][WeekTag]",
      "scheme_stable": "[Major].[Minor]-[Stage]",
      "example_dev": "5.14.23-dev.4g",
      "example_stable": "5-beta",
      "example_full_dev": "1.2.5.14.23-dev.4g → 1.2.5-b.0a"
    },
    "weektag": {
      "range": "a-m",
      "count": 13,
      "meaning": "Wochentag-Tracking: a=So, b=Mo, c=Di, d=Mi, e=Do, f=Fr, g=Sa",
      "note": "Nur bei Mini-Fixes relevant"
    },
    "stage_order": ["dev", "a", "b", "pre", "stable"]
  },

  "version_types": {
    "bugfix": {
      "trigger": "Kleine Fixes",
      "what_changes": "BugfixCount hoch",
      "display": "gleiche Anzeige, nur Count ändert sich",
      "example": "dev.1g → dev.2g"
    },
    "mini_update": {
      "trigger": "Mini-Update ohne neue Features",
      "what_changes": "MiniUpdateCount hoch",
      "display": "WeekTag bleibt, Mini hoch",
      "example": "dev.1g → dev.1h (gleiche Woche, neuer Mini-Fix)"
    },
    "update": {
      "trigger": "Neue Features",
      "what_changes": "Minor hoch, Bugfix/Mini/WeekTag reset",
      "display": "Anzeige: Minor hoch",
      "example": "5.14.23-dev.4g → 5.15.01-dev.1a"
    },
    "release": {
      "trigger": "Stable-Release",
      "what_changes": "Stable-Format, stark vereinfacht",
      "display": "Anzeige: nur noch [Major].[Minor]",
      "example": "5.14-dev → 5.0"
    }
  },

  "releases": {
    "0.0.5.14.23-dev.4g": {
      "display": "5.14.23-dev.4g",
      "display_short": "5.14-dev",
      "stage": "dev",
      "type": "update",
      "status": "current",
      "description": "Base hatches — Kanban, Docs, Notes, Websites, Teams, Integrations",
      "features": [
        "Kanban Board (multi-board, drag & drop, cards, assignment)",
        "Docs (Markdown editor with view mode toggle: preview/edit/both)",
        "Notes (Quick personal notes)",
        "Websites (Internal URL & project registry)",
        "Teams & Roles (Permission system per section)",
        "Integrations (GitHub, GitLab, Jira, Redmine, MantisBT, Confluence, Trello)",
        "Auth (Session-based, password hashing)",
        "Setup Wizard (/setup on first visit)"
      ],
      "tech": [
        "Astro 6 (SSR) + React Islands",
        "TypeScript",
        "Tailwind CSS v4",
        "Prisma 7",
        "dnd-kit",
        "@uiw/react-md-editor"
      ]
    },

    "0.5.14.23-a.4g": {
      "display": "5.14.23-alpha",
      "stage": "a",
      "type": "update",
      "status": "planned"
    },

    "0.0.5-b.14a": {
      "display": "5-beta",
      "stage": "b",
      "type": "bugfix",
      "status": "planned"
    },

    "0.0.0-pre.5a": {
      "display": "pre",
      "stage": "pre",
      "type": "release",
      "status": "planned"
    },

    "0.0.05a": {
      "display": "5.0",
      "stage": "stable",
      "type": "release",
      "status": "future",
      "description": "First stable release"
    }
  },

  "roadmap": {
    "next": [
      { "version": "0.5.14.23-a.4g", "name": "5.14.23-alpha", "stage": "a", "type": "update" },
      { "version": "0.0.5-b.14a", "name": "5-beta", "stage": "b", "type": "bugfix" },
      { "version": "0.0.0-pre.5a", "name": "pre", "stage": "pre", "type": "release" },
