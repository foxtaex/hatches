{
  "meta": {
    "name": "hatches",
    "description": "Self-hosted team workspace",
    "versioning": {
      "scheme": "[Release].[Patch]-[Status].[Count][Stage]",
      "explained": "Format: 0.1.2-dev.1a = Release.Patch-Status.CountStage. Statuses: alpha, beta, dev, pre (a-z). Examples: 0.1.2-dev.1a, 0.1.2-dev.2b, 0.1.3-alpha.1, 0.2.0-beta.1, 1.0.0.1"
    }
  },

