      { "version": "0.6.2.01-dev.1a", "name": "6.2.01-dev.1a", "stage": "dev", "type": "update", "description": "Headless CLI" },
      { "version": "0.6.3.01-dev.1a", "name": "6.3.01-dev.1a", "stage": "dev", "type": "update", "description": "External Editor" },
