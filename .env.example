# Copy this file to .env and fill in your values
# cp .env.example .env

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# Supported providers: sqlite | postgresql | mysql | mssql
DATABASE_PROVIDER="sqlite"

# SQLite (default — just a file, no server needed)
DATABASE_URL="file:./dev.db"

# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/devtool"

# MySQL example:
# DATABASE_URL="mysql://user:password@localhost:3306/devtool"

# MSSQL example:
# DATABASE_URL="sqlserver://localhost:1433;database=devtool;user=sa;password=YourPassword"

# ──────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────
# Random string, at least 32 characters
SESSION_SECRET="change-this-to-a-random-secret-min-32-chars"
