generator client {
  provider = "prisma-client-js"
}

// Provider wird per `npm run db:switch` automatisch gesetzt (sqlite | postgresql | mysql | sqlserver)
datasource db {
  provider = "sqlite"
}

// ── Kanban ────────────────────────────────────────────────
model Board {
  id        Int      @id @default(autoincrement())
  name      String   @default("Main Board")
  columns   Column[]
  createdAt DateTime @default(now())
}

model Column {
  id       Int    @id @default(autoincrement())
  title    String
  position Int
  boardId  Int
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]
}

model Card {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  position      Int
  columnId      Int
  column        Column         @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assigneeId    Int?
  assignee      User?          @relation(fields: [assigneeId], references: [id])
  externalIssue ExternalIssue?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ── Dokumentation ─────────────────────────────────────────
model Doc {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Notizen ───────────────────────────────────────────────
model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Websites ──────────────────────────────────────────────
model Website {
  id          Int      @id @default(autoincrement())
  name        String
  url         String?
  repoUrl     String?
  deployCmd   String?
  buildCmd    String?
  description String?
  status      String   @default("idle")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Auth ─────────────────────────────────────────────────
model User {
  id           Int              @id @default(autoincrement())
  username     String           @unique
  email        String           @unique
  passwordHash String
  displayName  String?
  isAdmin      Boolean          @default(false)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     Session[]
  memberships  TeamMembership[]
  cards        Card[]
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Teams & Permissions (WBB-Stil) ───────────────────────
model Team {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  color       String           @default("#6b7280")
  isDefault   Boolean          @default(false)
  priority    Int              @default(0)
  createdAt   DateTime         @default(now())
  memberships TeamMembership[]
  permissions Permission[]
}

model TeamMembership {
  id       Int      @id @default(autoincrement())
  userId   Int
  teamId   Int
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([userId, teamId])
}

// sections: board | docs | notes | websites | integrations | admin
model Permission {
  id        Int     @id @default(autoincrement())
  teamId    Int
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  section   String
  canView   Boolean @default(true)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([teamId, section])
}

// ── Externe Integrationen ────────────────────────────────
// type: github | gitlab | jira | redmine | mantisbt | confluence | trello
model Integration {
  id         Int             @id @default(autoincrement())
  type       String
  name       String
  baseUrl    String?
  token      String?
  projectKey String?
  extraConfig String?
  enabled    Boolean         @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  issues     ExternalIssue[]
}

model ExternalIssue {
  id            Int         @id @default(autoincrement())
  integrationId Int
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String
  title         String
  description   String?
  status        String?
  url           String?
  assignee      String?
  labels        String?
  importedAt    DateTime    @default(now())
  cardId        Int?        @unique
  card          Card?       @relation(fields: [cardId], references: [id])

  @@unique([integrationId, externalId])
}
