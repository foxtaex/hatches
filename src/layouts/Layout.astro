---
import "../styles/global.css";
import "@fortawesome/fontawesome-free/css/all.min.css";
import { HatchesLogo } from "../components/brand/HatchesLogo";
import { prisma } from "../lib/db";

export interface Props {
  title?: string;
  active?: "board" | "docs" | "notes" | "planner" | "templates" | "ai" | "admin" | "settings";
}

const { title = "Hatches", active } = Astro.props;
const user = (Astro.locals as any).user;

let workspaceName = "Hatches";
try {
  const ws = await prisma.workspaceConfig.findUnique({ where: { id: 1 } });
  if (ws?.name) workspaceName = ws.name;
} catch { /* DB not ready yet — use default */ }

const nav = [
  { href: "/board",     label: "Board",     key: "board",     icon: "fa-solid fa-table-columns" },
  { href: "/planner",   label: "Planner",   key: "planner",   icon: "fa-solid fa-calendar-days" },
  { href: "/docs",      label: "Docs",      key: "docs",      icon: "fa-solid fa-file-lines" },
  { href: "/notes",     label: "Notizen",   key: "notes",     icon: "fa-solid fa-note-sticky" },
  { href: "/templates", label: "Templates", key: "templates", icon: "fa-solid fa-layer-group" },
  { href: "/ai",        label: "KI",        key: "ai",        icon: "fa-solid fa-robot" },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root { --mint: #3CC79A; --mint-dim: rgba(60,199,154,0.12); }
      * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col" style="background:#000; color:rgba(255,255,255,0.95);">

    <!-- ── Glassmorphism Top Bar ───────────────────────────────────────── -->
    <header style="background:rgba(18,18,18,0.7); backdrop-filter:blur(40px) saturate(180%); -webkit-backdrop-filter:blur(40px) saturate(180%); border-bottom:1px solid rgba(255,255,255,0.08); position:sticky; top:0; z-index:100;">
      <nav style="display:flex; align-items:center; padding:0 32px; height:72px; gap:6px;">

        <!-- Logo lockup -->
        <a href="/board" class="flex items-center flex-shrink-0" style="text-decoration:none; margin-right:48px;">
          <HatchesLogo size={28} wordmark={true} wordmarkSize={20} label={workspaceName.toLowerCase()} client:load />
        </a>

        <!-- Nav links -->
        <div style="display:flex; gap:6px; flex:1;">
          {nav.map(({ href, label, key, icon }) => (
            <a
              href={href}
              class="nav-pill"
              style={`display:flex; align-items:center; gap:8px; padding:10px 16px; border:none; border-radius:10px; font-size:15px; font-weight:500; cursor:pointer; transition:all 0.3s cubic-bezier(0.4,0,0.2,1); text-decoration:none; ${
                active === key
                  ? "background:rgba(255,255,255,0.1); color:rgba(255,255,255,0.95); box-shadow:0 2px 8px rgba(0,0,0,0.1);"
                  : "background:transparent; color:rgba(255,255,255,0.6);"
              }`}
            >
              <i class={`${icon}`} style={`width:16px; text-align:center; font-size:14px;${active === key ? "" : ""}`}></i>
              {label}
            </a>
          ))}

          {user?.isAdmin && (
            <a
              href="/admin"
              class="nav-pill"
              style={`display:flex; align-items:center; gap:8px; padding:10px 16px; border:none; border-radius:10px; font-size:15px; font-weight:500; cursor:pointer; transition:all 0.3s cubic-bezier(0.4,0,0.2,1); text-decoration:none; ${
                active === "admin"
                  ? "background:rgba(255,255,255,0.1); color:rgba(255,255,255,0.95); box-shadow:0 2px 8px rgba(0,0,0,0.1);"
                  : "background:transparent; color:rgba(255,255,255,0.6);"
              }`}
            >
              <i class="fa-solid fa-gear" style="width:16px; text-align:center; font-size:14px;"></i>
              Admin
            </a>
          )}
        </div>

        <!-- Search button -->
        {user && (
          <button
            id="search-btn"
            style="display:flex; align-items:center; gap:8px; padding:8px 14px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08); border-radius:10px; cursor:pointer; color:rgba(255,255,255,0.45); font-size:13px; font-family:inherit; transition:all 0.2s; margin-right:8px;"
          >
            <i class="fa-solid fa-magnifying-glass" style="font-size:13px;"></i>
            <span>Suchen</span>
            <span style="margin-left:8px; background:rgba(255,255,255,0.08); border-radius:5px; padding:1px 6px; font-size:11px; letter-spacing:0.03em;">⌘K</span>
          </button>
        )}

        <!-- Right: user menu -->
        {user && (
          <div style="position:relative;">
            <button
              id="user-menu-btn"
              style={`display:flex; align-items:center; gap:10px; padding:8px 14px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.08); border-radius:12px; cursor:pointer; color:rgba(255,255,255,0.9); transition:all 0.3s cubic-bezier(0.4,0,0.2,1); font-family:inherit; font-size:15px;`}
            >
              <div style="width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg, #3CC79A 0%, #138A6E 100%); display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:600; color:#fff; box-shadow:0 2px 8px rgba(60,199,154,0.3);">
                {(user.displayName || user.username).charAt(0).toUpperCase()}
              </div>
              <span style="font-weight:500;">{user.displayName || user.username}</span>
              <i class="fa-solid fa-chevron-down" style="font-size:10px; opacity:0.6;"></i>
            </button>

            <!-- Dropdown -->
            <div id="user-dropdown" style="display:none; position:absolute; top:100%; right:0; margin-top:12px; width:220px; background:rgba(28,28,28,0.85); backdrop-filter:blur(40px) saturate(180%); -webkit-backdrop-filter:blur(40px) saturate(180%); border:1px solid rgba(255,255,255,0.1); border-radius:14px; box-shadow:0 8px 32px rgba(0,0,0,0.6); z-index:1000; padding:6px;">
              <a href="/settings" style="width:100%; display:flex; align-items:center; gap:10px; padding:12px 14px; background:transparent; border:none; color:rgba(255,255,255,0.9); font-size:15px; cursor:pointer; text-align:left; border-radius:8px; transition:background-color 0.2s; text-decoration:none; font-family:inherit;">
                <i class="fa-solid fa-user" style="width:16px; opacity:0.8;"></i>
                Mein Account
              </a>
              <div style="height:1px; background:rgba(255,255,255,0.08); margin:6px 8px;"></div>
              <button id="logout-btn" style="width:100%; display:flex; align-items:center; gap:10px; padding:12px 14px; background:transparent; border:none; color:#ef4444; font-size:15px; cursor:pointer; text-align:left; border-radius:8px; transition:background-color 0.2s; font-family:inherit;">
                <i class="fa-solid fa-arrow-right-from-bracket" style="width:16px;"></i>
                Abmelden
              </button>
            </div>
          </div>
        )}
      </nav>
    </header>

    <main class="flex-1 flex flex-col overflow-hidden" style="background:#000;">
      <slot />
    </main>

    <style>
      .nav-pill:hover {
        background: rgba(255,255,255,0.08) !important;
        color: rgba(255,255,255,0.85) !important;
        transform: scale(1.02);
      }
      #user-menu-btn:hover {
        background: rgba(255,255,255,0.12) !important;
        transform: scale(1.02);
      }
      #user-dropdown a:hover,
      #user-dropdown button:hover {
        background: rgba(255,255,255,0.1);
      }
      #user-dropdown #logout-btn:hover {
        background: rgba(239,68,68,0.1);
      }
    </style>

    <!-- ── Suche Modal ──────────────────────────────────────────────── -->
    <div id="search-modal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.7); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); align-items:flex-start; justify-content:center; padding-top:120px;">
      <div style="width:100%; max-width:560px; margin:0 16px; background:rgba(22,22,24,0.98); border:1px solid rgba(255,255,255,0.12); border-radius:18px; box-shadow:0 24px 80px rgba(0,0,0,0.8); overflow:hidden;">

        <!-- Input -->
        <div style="display:flex; align-items:center; gap:12px; padding:16px 20px; border-bottom:1px solid rgba(255,255,255,0.07);">
          <i class="fa-solid fa-magnifying-glass" style="color:rgba(255,255,255,0.3); font-size:15px; flex-shrink:0;"></i>
          <input
            id="search-input"
            type="text"
            placeholder="Suchen in Board, Docs, Notizen, Planner…"
            style="flex:1; background:transparent; border:none; outline:none; color:rgba(255,255,255,0.9); font-size:15px; font-family:inherit;"
            autocomplete="off"
          />
          <kbd style="background:rgba(255,255,255,0.07); border-radius:5px; padding:2px 7px; font-size:11px; color:rgba(255,255,255,0.3); font-family:inherit; flex-shrink:0;">Esc</kbd>
        </div>

        <!-- Results -->
        <div id="search-results" style="max-height:420px; overflow-y:auto; padding:8px;"></div>

        <!-- Footer hint -->
        <div id="search-empty" style="padding:32px; text-align:center; color:rgba(255,255,255,0.2); font-size:13px;">Mindestens 2 Zeichen eingeben</div>
      </div>
    </div>

    <script>
      // User dropdown toggle
      const menuBtn = document.getElementById("user-menu-btn");
      const dropdown = document.getElementById("user-dropdown");
      if (menuBtn && dropdown) {
        menuBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          dropdown.style.display = dropdown.style.display === "none" ? "block" : "none";
        });
        document.addEventListener("click", () => {
          dropdown.style.display = "none";
        });
        dropdown.addEventListener("click", (e) => e.stopPropagation());
      }

      // Logout
      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        window.location.href = "/login";
      });

      // ── Suche ────────────────────────────────────────────────────
      const searchModal  = document.getElementById("search-modal")!;
      const searchInput  = document.getElementById("search-input") as HTMLInputElement | null;
      const searchResults= document.getElementById("search-results")!;
      const searchEmpty  = document.getElementById("search-empty")!;

      function openSearch() {
        if (!searchModal) return;
        searchModal.style.display = "flex";
        searchInput?.focus();
      }
      function closeSearch() {
        if (!searchModal) return;
        searchModal.style.display = "none";
        if (searchInput) searchInput.value = "";
        if (searchResults) searchResults.innerHTML = "";
        if (searchEmpty) { searchEmpty.style.display = "block"; searchEmpty.textContent = "Mindestens 2 Zeichen eingeben"; }
      }

      document.getElementById("search-btn")?.addEventListener("click", openSearch);
      searchModal?.addEventListener("click", (e) => { if (e.target === searchModal) closeSearch(); });

      // Cmd+K / Ctrl+K
      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") { e.preventDefault(); openSearch(); }
        if (e.key === "Escape") closeSearch();
      });

      // Debounce search
      let searchTimer: ReturnType<typeof setTimeout>;
      searchInput?.addEventListener("input", () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(runSearch, 220);
      });

      const ICONS: Record<string, string> = {
        cards:     "fa-solid fa-table-columns",
        docs:      "fa-solid fa-file-lines",
        notes:     "fa-solid fa-note-sticky",
        boards:    "fa-solid fa-layer-group",
        events:    "fa-solid fa-calendar-days",
        templates: "fa-solid fa-clipboard",
      };
      const LABELS: Record<string, string> = {
        cards:     "Board-Karte",
        docs:      "Dokument",
        notes:     "Notiz",
        boards:    "Board",
        events:    "Termin",
        templates: "Template",
      };
      const HREFS: Record<string, (r: Record<string, unknown>) => string> = {
        cards:     (r) => { const boardId = (r.column as any)?.board?.id; return boardId ? `/board?boardId=${boardId}` : `/board`; },
        docs:      (r) => `/docs?id=${r.id}`,
        notes:     (r) => `/notes?id=${r.id}`,
        boards:    (r) => `/board?boardId=${r.id}`,
        events:    (_r) => `/planner`,
        templates: (_r) => `/templates`,
      };

      async function runSearch() {
        const q = searchInput?.value.trim() ?? "";
        if (q.length < 2) {
          searchResults.innerHTML = "";
          searchEmpty.style.display = "block";
          searchEmpty.textContent = "Mindestens 2 Zeichen eingeben";
          return;
        }
        searchEmpty.style.display = "none";
        searchResults.innerHTML = `<div style="padding:16px 12px; color:rgba(255,255,255,0.3); font-size:13px;">Suche…</div>`;

        const res  = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
        const data = await res.json() as Record<string, Record<string, unknown>[]>;

        const total = Object.values(data).flat().length;
        if (total === 0) {
          searchResults.innerHTML = `<div style="padding:32px; text-align:center; color:rgba(255,255,255,0.25); font-size:13px;">Keine Ergebnisse für „${q}"</div>`;
          return;
        }

        let html = "";
        for (const [type, items] of Object.entries(data)) {
          if (!items.length) continue;
          html += `<div style="padding:6px 10px 2px; font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; color:rgba(255,255,255,0.3);">${LABELS[type] ?? type}</div>`;
          for (const item of items) {
            const title = (item.title ?? item.name ?? "") as string;
            const sub   = (item.description ?? item.content ?? "") as string;
            const href  = HREFS[type]?.(item) ?? "/";
            const icon  = ICONS[type] ?? "fa-solid fa-circle";
            // For events use their color, for templates use icon emoji
            const iconColor = type === "events" && item.color ? item.color as string : "rgba(255,255,255,0.35)";
            const prefixEmoji = type === "templates" && item.icon ? `<span style="font-size:14px;margin-right:2px;">${item.icon}</span>` : "";
            const hi    = title.replace(new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")})`, "gi"), `<mark style="background:rgba(60,199,154,0.25);color:#3CC79A;border-radius:2px;">$1</mark>`);
            html += `
              <a href="${href}" onclick="setTimeout(()=>{ document.getElementById('search-modal').style.display='none'; },50)"
                style="display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:10px; text-decoration:none; transition:background 0.15s; cursor:pointer;"
                onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background='transparent'">
                ${prefixEmoji || `<i class="${icon}" style="width:14px; text-align:center; color:${iconColor}; font-size:13px; flex-shrink:0;"></i>`}
                <div style="flex:1; min-width:0;">
                  <div style="font-size:13px; font-weight:500; color:rgba(255,255,255,0.88); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${hi}</div>
                  ${sub ? `<div style="font-size:11px; color:rgba(255,255,255,0.3); margin-top:1px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${sub.slice(0,80)}</div>` : ""}
                </div>
              </a>`;
          }
        }
        searchResults.innerHTML = html;
      }
    </script>
  </body>
</html>
