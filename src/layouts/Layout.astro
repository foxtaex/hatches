---
import "../styles/global.css";
import { HatchesLogo } from "../components/brand/HatchesLogo";

export interface Props {
  title?: string;
  active?: "board" | "docs" | "notes" | "websites" | "integrations" | "admin";
}

const { title = "Hatches", active } = Astro.props;
const user = (Astro.locals as any).user;

const nav = [
  { href: "/board",        label: "Board",        key: "board",        icon: "fa-solid fa-table-columns" },
  { href: "/docs",         label: "Docs",         key: "docs",         icon: "fa-solid fa-book" },
  { href: "/notes",        label: "Notizen",      key: "notes",        icon: "fa-solid fa-note-sticky" },
  { href: "/websites",     label: "Websites",     key: "websites",     icon: "fa-solid fa-globe" },
  { href: "/integrations", label: "Integrationen",key: "integrations", icon: "fa-solid fa-plug" },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
      :root {
        --mint: #3CC79A;
        --mint-dim: rgba(60,199,154,0.12);
      }
      * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif; }
    </style>
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col">

    <!-- ── Top bar ─────────────────────────────────────────────────────── -->
    <header style="border-bottom:1px solid rgba(255,255,255,0.06); background:rgba(9,11,13,0.92); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px); position:sticky; top:0; z-index:50;">
      <nav class="flex items-center gap-0.5 px-3 h-11">

        <!-- Logo lockup -->
        <a href="/board" class="flex items-center mr-3 flex-shrink-0" style="text-decoration:none;">
          <HatchesLogo size={22} wordmark={true} wordmarkSize={15} client:load />
        </a>

        <!-- Nav links -->
        {nav.map(({ href, label, key, icon }) => (
          <a
            href={href}
            class={`flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-[13px] font-medium transition-all duration-150 ${
              active === key
                ? "text-white"
                : "text-zinc-500 hover:text-zinc-200 hover:bg-white/[0.06]"
            }`}
            style={active === key ? "background:rgba(60,199,154,0.13); color:#5DDBB0;" : ""}
          >
            <i class={`${icon} text-[11px]`} style={active === key ? "color:#3CC79A;" : ""}></i>
            {label}
          </a>
        ))}

        {user?.isAdmin && (
          <a
            href="/admin"
            class={`flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-[13px] font-medium transition-all duration-150 ml-0.5 ${
              active === "admin"
                ? "text-white"
                : "text-zinc-600 hover:text-zinc-400 hover:bg-white/[0.04]"
            }`}
            style={active === "admin" ? "background:rgba(60,199,154,0.10); color:#5DDBB0;" : ""}
          >
            <i class="fa-solid fa-shield-halved text-[11px]" style={active === "admin" ? "color:#3CC79A;" : ""}></i>
            Admin
          </a>
        )}

        <!-- Right side: user + logout -->
        <div class="ml-auto flex items-center gap-2">
          {user && (
            <>
              <div class="flex items-center gap-2">
                <div
                  class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-semibold"
                  style="background:rgba(60,199,154,0.18); color:#3CC79A; letter-spacing:-0.01em;"
                >
                  {(user.displayName || user.username).charAt(0).toUpperCase()}
                </div>
                <span class="text-[12px] text-zinc-500 font-medium" style="letter-spacing:-0.01em;">
                  {user.displayName || user.username}
                </span>
              </div>
              <button
                id="logout-btn"
                class="flex items-center gap-1 text-[11px] text-zinc-700 hover:text-zinc-400 transition-colors px-2 py-1 rounded hover:bg-white/[0.04]"
              >
                <i class="fa-solid fa-right-from-bracket text-[10px]"></i>
                Abmelden
              </button>
            </>
          )}
        </div>
      </nav>
    </header>

    <main class="flex-1 flex flex-col overflow-hidden">
      <slot />
    </main>

    <script>
      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        window.location.href = "/login";
      });
    </script>
  </body>
</html>
