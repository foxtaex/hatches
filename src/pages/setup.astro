---
import { SetupWizard } from "../components/setup/SetupWizard";
import versionData from "../../Sync/version.json";
const version: string = versionData.current_display;

// Determine which step to start on:
//  "db"    → tables don't exist yet (fresh install)
//  "admin" → tables exist, no users yet
// Any other state → redirect away
let initialStep: "db" | "admin" = "admin";

try {
  const { countUsers } = await import("../lib/auth");
  const count = await countUsers();
  if (count > 0) return Astro.redirect("/login");
  initialStep = "admin";
} catch {
  // DB tables don't exist — show DB config step first
  initialStep = "db";
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Setup — Hatches</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col items-center justify-center">
    <SetupWizard initialStep={initialStep} client:only="react" />
    <p class="mt-8 text-[11px] text-white/20 tracking-[0.02em]">HATCHES · SELF-HOSTED · v{version}</p>
  </body>
</html>
