---
import Layout from "../layouts/Layout.astro";
const user = (Astro.locals as any).user;
if (!user) return Astro.redirect("/login");
---

<Layout title="Einstellungen — Hatches" active="settings">
  <div style="flex:1; overflow:auto; background:#000;">
    <div style="max-width:800px; margin:0 auto; padding:48px 32px;">

      <!-- Profile card -->
      <div style="background:rgba(24,24,27,0.8); border-radius:12px; border:1px solid rgba(255,255,255,0.08); padding:32px; margin-bottom:24px;">
        <div style="display:flex; gap:24px; align-items:flex-start;">
          <!-- Avatar -->
          <div style="width:120px; height:120px; border-radius:50%; background:linear-gradient(135deg, #3CC79A 0%, #138A6E 100%); display:flex; align-items:center; justify-content:center; font-size:48px; font-weight:700; color:#fff; border:3px solid rgba(255,255,255,0.08); box-shadow:0 4px 20px rgba(60,199,154,0.3);">
            {(user.displayName || user.username).charAt(0).toUpperCase()}
          </div>
          <div style="flex:1;">
            <h1 style="font-size:32px; font-weight:700; margin:0 0 4px 0; color:rgba(244,244,245,0.95);">
              {user.displayName || user.username}
            </h1>
            <p style="font-size:16px; color:rgba(113,113,122,0.9); margin:0 0 20px 0;">
              @{user.username}
            </p>
            <p style="font-size:14px; color:rgba(161,161,170,0.8); margin:0;">
              {user.email}
            </p>
          </div>
        </div>
      </div>

      <!-- Account settings card -->
      <div style="background:rgba(24,24,27,0.8); border-radius:12px; border:1px solid rgba(255,255,255,0.08); padding:24px; margin-bottom:24px;">
        <h2 style="font-size:20px; font-weight:600; margin:0 0 20px 0; color:rgba(244,244,245,0.95);">
          Account-Einstellungen
        </h2>
        <div style="display:grid; gap:20px;">
          <div>
            <label style="display:block; font-size:13px; font-weight:600; color:rgba(212,212,216,0.9); margin-bottom:8px;">
              Anzeigename
            </label>
            <input id="displayName" type="text"
              value={user.displayName ?? ""}
              placeholder={user.username}
              style="width:100%; background:rgba(39,39,42,0.8); border:1px solid rgba(255,255,255,0.1); color:rgba(244,244,245,0.95); border-radius:8px; padding:10px 12px; font-size:14px; outline:none; font-family:inherit; transition:border-color 0.2s;"
              onfocus="this.style.borderColor='rgba(60,199,154,0.5)'"
              onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>
          <div>
            <label style="display:block; font-size:13px; font-weight:600; color:rgba(212,212,216,0.9); margin-bottom:8px;">
              E-Mail
            </label>
            <input type="email" disabled
              value={user.email}
              style="width:100%; background:rgba(24,24,27,0.8); border:1px solid rgba(255,255,255,0.06); color:rgba(161,161,170,0.8); border-radius:8px; padding:10px 12px; font-size:14px; outline:none; font-family:inherit; cursor:not-allowed;" />
          </div>
          <button id="saveDisplayName"
            style="background:linear-gradient(135deg, #3b82f6 0%, #1e40af 100%); color:white; border:none; border-radius:12px; padding:12px 24px; font-size:14px; font-weight:600; cursor:pointer; box-shadow:0 4px 14px rgba(59,130,246,0.4); transition:all 200ms; width:fit-content; font-family:inherit;">
            Speichern
          </button>
          <p id="displayNameMsg" style="font-size:13px; display:none;"></p>
        </div>
      </div>

      <!-- Password card -->
      <div style="background:rgba(24,24,27,0.8); border-radius:12px; border:1px solid rgba(255,255,255,0.08); padding:24px;">
        <h2 style="font-size:20px; font-weight:600; margin:0 0 20px 0; color:rgba(244,244,245,0.95);">
          Passwort ändern
        </h2>
        <div style="display:grid; gap:20px;">
          <div>
            <label style="display:block; font-size:13px; font-weight:600; color:rgba(212,212,216,0.9); margin-bottom:8px;">
              Aktuelles Passwort
            </label>
            <input id="currentPw" type="password" placeholder="••••••••"
              style="width:100%; background:rgba(39,39,42,0.8); border:1px solid rgba(255,255,255,0.1); color:rgba(244,244,245,0.95); border-radius:8px; padding:10px 12px; font-size:14px; outline:none; font-family:inherit; transition:border-color 0.2s;"
              onfocus="this.style.borderColor='rgba(60,199,154,0.5)'"
              onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>
          <div>
            <label style="display:block; font-size:13px; font-weight:600; color:rgba(212,212,216,0.9); margin-bottom:8px;">
              Neues Passwort
            </label>
            <input id="newPw" type="password" placeholder="min. 6 Zeichen"
              style="width:100%; background:rgba(39,39,42,0.8); border:1px solid rgba(255,255,255,0.1); color:rgba(244,244,245,0.95); border-radius:8px; padding:10px 12px; font-size:14px; outline:none; font-family:inherit; transition:border-color 0.2s;"
              onfocus="this.style.borderColor='rgba(60,199,154,0.5)'"
              onblur="this.style.borderColor='rgba(255,255,255,0.1)'" />
          </div>
          <p id="pwMsg" style="font-size:13px; display:none;"></p>
          <button id="changePw"
            style="background:linear-gradient(135deg, #3b82f6 0%, #1e40af 100%); color:white; border:none; border-radius:12px; padding:12px 24px; font-size:14px; font-weight:600; cursor:pointer; box-shadow:0 4px 14px rgba(59,130,246,0.4); transition:all 200ms; width:fit-content; font-family:inherit;">
            Passwort ändern
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Display name
  document.getElementById("saveDisplayName")?.addEventListener("click", async () => {
    const msg = document.getElementById("displayNameMsg")!;
    const val = (document.getElementById("displayName") as HTMLInputElement).value;
    const res = await fetch("/api/user/profile", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ displayName: val }),
    });
    const data = await res.json();
    msg.textContent = data.ok ? "Gespeichert" : (data.error ?? "Fehler");
    msg.style.color = data.ok ? "rgb(74 222 128)" : "rgb(248 113 113)";
    msg.style.display = "block";
  });

  // Password
  document.getElementById("changePw")?.addEventListener("click", async () => {
    const msg = document.getElementById("pwMsg")!;
    const current = (document.getElementById("currentPw") as HTMLInputElement).value;
    const next    = (document.getElementById("newPw") as HTMLInputElement).value;
    const res = await fetch("/api/user/password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ current, next }),
    });
    const data = await res.json();
    msg.textContent = data.ok ? "Passwort geändert" : (data.error ?? "Fehler");
    msg.style.color = data.ok ? "rgb(74 222 128)" : "rgb(248 113 113)";
    msg.style.display = "block";
    if (data.ok) {
      (document.getElementById("currentPw") as HTMLInputElement).value = "";
      (document.getElementById("newPw") as HTMLInputElement).value = "";
    }
  });
</script>
