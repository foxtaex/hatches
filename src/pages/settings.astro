---
import Layout from "../layouts/Layout.astro";
const user = (Astro.locals as any).user;
if (!user) return Astro.redirect("/login");
---

<Layout title="Einstellungen — Hatches" active="settings">
  <div class="flex-1 overflow-auto bg-black">
    <div class="max-w-2xl mx-auto px-8 py-12 flex flex-col gap-6">

      <!-- Profil-Header -->
      <div class="bg-[rgba(24,24,27,0.8)] border border-[rgba(255,255,255,0.08)] rounded-2xl p-8">
        <div class="flex gap-6 items-center">
          <div class="w-20 h-20 rounded-full flex-shrink-0 flex items-center justify-center text-3xl font-bold text-white"
            style="background:linear-gradient(135deg,#3CC79A,#138A6E); box-shadow:0 4px 20px rgba(60,199,154,0.3);">
            {(user.displayName || user.username).charAt(0).toUpperCase()}
          </div>
          <div>
            <h1 class="text-2xl font-bold text-white/95 leading-tight">
              {user.displayName || user.username}
            </h1>
            <p class="text-sm text-zinc-500 mt-0.5">@{user.username}</p>
            <p class="text-sm text-zinc-400 mt-1">{user.email}</p>
          </div>
        </div>
      </div>

      <!-- Anzeigename -->
      <div class="bg-[rgba(24,24,27,0.8)] border border-[rgba(255,255,255,0.08)] rounded-2xl p-6 flex flex-col gap-5">
        <h2 class="text-base font-semibold text-white/90">Account-Einstellungen</h2>

        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider">Anzeigename</label>
          <input id="displayName" type="text"
            value={user.displayName ?? ""}
            placeholder={user.username}
            class="w-full bg-[rgba(39,39,42,0.8)] border border-[rgba(255,255,255,0.1)] text-white/95 rounded-xl px-4 py-2.5 text-sm outline-none transition-colors focus:border-[rgba(60,199,154,0.5)] font-[inherit]" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider">E-Mail</label>
          <input type="email" disabled value={user.email}
            class="w-full bg-[rgba(24,24,27,0.8)] border border-[rgba(255,255,255,0.06)] text-zinc-500 rounded-xl px-4 py-2.5 text-sm outline-none cursor-not-allowed" />
        </div>

        <div class="flex items-center gap-3">
          <button id="saveDisplayName"
            class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-[#3CC79A] hover:bg-[#34b389] transition-colors">
            Speichern
          </button>
          <p id="displayNameMsg" class="text-sm hidden"></p>
        </div>
      </div>

      <!-- Passwort -->
      <div class="bg-[rgba(24,24,27,0.8)] border border-[rgba(255,255,255,0.08)] rounded-2xl p-6 flex flex-col gap-5">
        <h2 class="text-base font-semibold text-white/90">Passwort ändern</h2>

        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider">Aktuelles Passwort</label>
          <input id="currentPw" type="password" placeholder="••••••••"
            class="w-full bg-[rgba(39,39,42,0.8)] border border-[rgba(255,255,255,0.1)] text-white/95 rounded-xl px-4 py-2.5 text-sm outline-none transition-colors focus:border-[rgba(60,199,154,0.5)] font-[inherit]" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider">Neues Passwort</label>
          <input id="newPw" type="password" placeholder="min. 6 Zeichen"
            class="w-full bg-[rgba(39,39,42,0.8)] border border-[rgba(255,255,255,0.1)] text-white/95 rounded-xl px-4 py-2.5 text-sm outline-none transition-colors focus:border-[rgba(60,199,154,0.5)] font-[inherit]" />
        </div>

        <div class="flex items-center gap-3">
          <button id="changePw"
            class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-[#3CC79A] hover:bg-[#34b389] transition-colors">
            Passwort ändern
          </button>
          <p id="pwMsg" class="text-sm hidden"></p>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  document.getElementById("saveDisplayName")?.addEventListener("click", async () => {
    const msg = document.getElementById("displayNameMsg")!;
    const val = (document.getElementById("displayName") as HTMLInputElement).value;
    const res = await fetch("/api/user/profile", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ displayName: val }),
    });
    const data = await res.json();
    msg.textContent = data.ok ? "✓ Gespeichert" : (data.error ?? "Fehler");
    msg.className = `text-sm ${data.ok ? "text-[#3CC79A]" : "text-red-400"}`;
    msg.classList.remove("hidden");
  });

  document.getElementById("changePw")?.addEventListener("click", async () => {
    const msg = document.getElementById("pwMsg")!;
    const current = (document.getElementById("currentPw") as HTMLInputElement).value;
    const next    = (document.getElementById("newPw") as HTMLInputElement).value;
    const res = await fetch("/api/user/password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ current, next }),
    });
    const data = await res.json();
    msg.textContent = data.ok ? "✓ Passwort geändert" : (data.error ?? "Fehler");
    msg.className = `text-sm ${data.ok ? "text-[#3CC79A]" : "text-red-400"}`;
    msg.classList.remove("hidden");
    if (data.ok) {
      (document.getElementById("currentPw") as HTMLInputElement).value = "";
      (document.getElementById("newPw") as HTMLInputElement).value = "";
    }
  });
</script>
