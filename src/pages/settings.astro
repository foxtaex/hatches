---
import Layout from "../layouts/Layout.astro";
const user = (Astro.locals as any).user;
const sessionId = (Astro.locals as any).sessionId as string | undefined;
if (!user) return Astro.redirect("/login");
---

<Layout title="Einstellungen — Hatches" active="settings">
  <div class="flex-1 overflow-auto bg-black">
    <div class="max-w-2xl mx-auto px-8 py-12 flex flex-col gap-6">

      <!-- Profil-Header -->
      <div class="bg-[rgba(24,24,27,0.8)] border border-[rgba(255,255,255,0.08)] rounded-2xl p-8">
        <div class="flex gap-6 items-center">
          <div class="w-20 h-20 rounded-full flex-shrink-0 flex items-center justify-center text-3xl font-bold text-white"
            style="background:linear-gradient(135deg,#3CC79A,#138A6E); box-shadow:0 4px 20px rgba(60,199,154,0.3);">
            {(user.displayName || user.username).charAt(0).toUpperCase()}
          </div>
          <div>
            <h1 class="text-2xl font-bold text-white/95 leading-tight">
              {user.displayName || user.username}
            </h1>
            <p class="text-sm text-zinc-500 mt-0.5">@{user.username}</p>
            <p class="text-sm text-zinc-400 mt-1">{user.email}</p>
            {user.bio && <p class="text-sm text-zinc-500 mt-2 leading-relaxed">{user.bio}</p>}
          </div>
        </div>
      </div>

      <!-- Anzeigename -->
      <div class="bg-[rgba(24,24,27,0.8)] border border-[rgba(255,255,255,0.08)] rounded-2xl p-6 flex flex-col gap-5">
        <h2 class="text-base font-semibold text-white/90">Account-Einstellungen</h2>

        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider">Anzeigename</label>
          <input id="displayName" type="text"
            value={user.displayName ?? ""}
            placeholder={user.username}
            class="w-full bg-[rgba(39,39,42,0.8)] border border-[rgba(255,255,255,0.1)] text-white/95 rounded-xl px-4 py-2.5 text-sm outline-none transition-colors focus:border-[rgba(60,199,154,0.5)] font-[inherit]" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider">E-Mail</label>
          <input type="email" disabled value={user.email}
            class="w-full bg-[rgba(24,24,27,0.8)] border border-[rgba(255,255,255,0.06)] text-zinc-500 rounded-xl px-4 py-2.5 text-sm outline-none cursor-not-allowed" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider">Bio</label>
          <textarea id="bio" rows={3} placeholder="Kurze Beschreibung über dich…" maxlength={280}
            class="w-full bg-[rgba(39,39,42,0.8)] border border-[rgba(255,255,255,0.1)] text-white/95 rounded-xl px-4 py-2.5 text-sm outline-none transition-colors focus:border-[rgba(60,199,154,0.5)] font-[inherit] resize-none">{user.bio ?? ""}</textarea>
          <p class="text-xs text-zinc-600">Maximal 280 Zeichen</p>
        </div>

        <div class="flex items-center gap-3">
          <button id="saveDisplayName"
            class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-[#3CC79A] hover:bg-[#34b389] transition-colors">
            Speichern
          </button>
          <p id="displayNameMsg" class="text-sm hidden"></p>
        </div>
      </div>

      <!-- Passwort -->
      <div class="bg-[rgba(24,24,27,0.8)] border border-[rgba(255,255,255,0.08)] rounded-2xl p-6 flex flex-col gap-5">
        <h2 class="text-base font-semibold text-white/90">Passwort ändern</h2>

        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider">Aktuelles Passwort</label>
          <input id="currentPw" type="password" placeholder="••••••••"
            class="w-full bg-[rgba(39,39,42,0.8)] border border-[rgba(255,255,255,0.1)] text-white/95 rounded-xl px-4 py-2.5 text-sm outline-none transition-colors focus:border-[rgba(60,199,154,0.5)] font-[inherit]" />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-semibold text-white/60 uppercase tracking-wider">Neues Passwort</label>
          <input id="newPw" type="password" placeholder="min. 6 Zeichen"
            class="w-full bg-[rgba(39,39,42,0.8)] border border-[rgba(255,255,255,0.1)] text-white/95 rounded-xl px-4 py-2.5 text-sm outline-none transition-colors focus:border-[rgba(60,199,154,0.5)] font-[inherit]" />
        </div>

        <div class="flex items-center gap-3">
          <button id="changePw"
            class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-[#3CC79A] hover:bg-[#34b389] transition-colors">
            Passwort ändern
          </button>
          <p id="pwMsg" class="text-sm hidden"></p>
        </div>
      </div>

      <!-- Aktive Sitzungen -->
      <div class="bg-[rgba(24,24,27,0.8)] border border-[rgba(255,255,255,0.08)] rounded-2xl p-6 flex flex-col gap-5">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-semibold text-white/90">Aktive Sitzungen</h2>
          <button id="revokeAll"
            class="text-xs font-medium px-3 py-1.5 rounded-lg border border-red-800/40 text-red-400 hover:bg-red-900/20 transition-colors">
            Alle anderen beenden
          </button>
        </div>
        <div id="sessionList" class="flex flex-col gap-2">
          <p class="text-sm text-zinc-600">Lade Sitzungen…</p>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  document.getElementById("saveDisplayName")?.addEventListener("click", async () => {
    const msg = document.getElementById("displayNameMsg")!;
    const displayName = (document.getElementById("displayName") as HTMLInputElement).value;
    const bio = (document.getElementById("bio") as HTMLTextAreaElement).value;
    const res = await fetch("/api/user/profile", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ displayName, bio }),
    });
    const data = await res.json();
    msg.textContent = data.ok ? "✓ Gespeichert" : (data.error ?? "Fehler");
    msg.className = `text-sm ${data.ok ? "text-[#3CC79A]" : "text-red-400"}`;
    msg.classList.remove("hidden");
  });

  document.getElementById("changePw")?.addEventListener("click", async () => {
    const msg = document.getElementById("pwMsg")!;
    const current = (document.getElementById("currentPw") as HTMLInputElement).value;
    const next    = (document.getElementById("newPw") as HTMLInputElement).value;
    const res = await fetch("/api/user/password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ current, next }),
    });
    const data = await res.json();
    msg.textContent = data.ok ? "✓ Passwort geändert" : (data.error ?? "Fehler");
    msg.className = `text-sm ${data.ok ? "text-[#3CC79A]" : "text-red-400"}`;
    msg.classList.remove("hidden");
    if (data.ok) {
      (document.getElementById("currentPw") as HTMLInputElement).value = "";
      (document.getElementById("newPw") as HTMLInputElement).value = "";
    }
  });

  // ── Sitzungen ────────────────────────────────────────────
  const CURRENT_SESSION_ID = {JSON.stringify(sessionId)};

  function formatDate(iso: string) {
    return new Date(iso).toLocaleString("de-DE", { dateStyle: "medium", timeStyle: "short" });
  }

  async function loadSessions() {
    const list = document.getElementById("sessionList")!;
    const res = await fetch("/api/user/sessions");
    const sessions: { id: string; createdAt: string; expiresAt: string }[] = await res.json();
    if (!sessions.length) {
      list.innerHTML = '<p class="text-sm text-zinc-600">Keine aktiven Sitzungen gefunden.</p>';
      return;
    }
    list.innerHTML = sessions.map((s) => {
      const isCurrent = s.id === CURRENT_SESSION_ID;
      return `
        <div class="flex items-center gap-3 px-4 py-3 bg-[rgba(255,255,255,0.03)] border border-[rgba(255,255,255,0.06)] rounded-xl">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-sm text-white/80 font-mono">${s.id.slice(0, 12)}…</span>
              ${isCurrent ? '<span class="text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-md bg-[rgba(60,199,154,0.15)] text-[#3CC79A]">Aktuelle Sitzung</span>' : ""}
            </div>
            <p class="text-xs text-zinc-600 mt-0.5">Gestartet: ${formatDate(s.createdAt)} · Läuft ab: ${formatDate(s.expiresAt)}</p>
          </div>
          ${isCurrent ? "" : `<button data-id="${s.id}" class="revoke-btn text-xs text-zinc-600 hover:text-red-400 transition-colors px-2 py-1 rounded hover:bg-zinc-800">Beenden</button>`}
        </div>
      `;
    }).join("");

    document.querySelectorAll(".revoke-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = (btn as HTMLElement).dataset.id!;
        await fetch("/api/user/sessions", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id }),
        });
        loadSessions();
      });
    });
  }

  document.getElementById("revokeAll")?.addEventListener("click", async () => {
    const res = await fetch("/api/user/sessions");
    const sessions: { id: string }[] = await res.json();
    await Promise.all(
      sessions
        .filter((s) => s.id !== CURRENT_SESSION_ID)
        .map((s) => fetch("/api/user/sessions", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: s.id }),
        }))
    );
    loadSessions();
  });

  loadSessions();
</script>
