---
import { getSession, getSessionCookie, countUsers } from "../lib/auth";
import versionData from "../../Sync/version.json";
const count = await countUsers();
if (count === 0) return Astro.redirect("/setup");
const session = await getSession(getSessionCookie(Astro.request.headers.get("cookie")));
if (session) return Astro.redirect("/projects");
const redirect = new URL(Astro.request.url).searchParams.get("redirect") ?? "/projects";
const version: string = versionData.current_display;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Login — Hatches</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <style>
      * { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif; }
      input:-webkit-autofill {
        -webkit-box-shadow: 0 0 0 1000px #1c1f23 inset !important;
        -webkit-text-fill-color: #f4f4f5 !important;
      }
    </style>
  </head>
  <body style="background:#000; color:#f4f4f5; min-height:100vh; display:flex; align-items:center; justify-content:center;">

    <div style="width:100%; max-width:380px; padding:0 24px;">

      <!-- Logo hero -->
      <div style="display:flex; flex-direction:column; align-items:center; margin-bottom:48px; gap:22px;">
        <!-- Mark A Vivid — 72px -->
        <svg width="72" height="72" viewBox="0 0 280 280" aria-label="Hatches">
          <defs>
            <linearGradient id="lm" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%"   stop-color="#3CC79A"/>
              <stop offset="100%" stop-color="#138A6E"/>
            </linearGradient>
            <linearGradient id="ll" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%"   stop-color="#aef0d2"/>
              <stop offset="100%" stop-color="#3CC79A"/>
            </linearGradient>
          </defs>
          <path d="M 64 20 Q 20 20 20 64 L 20 216 Q 20 260 64 260 L 216 260 Q 260 260 260 216 L 260 64 Q 260 20 216 20 Z" fill="url(#lm)"/>
          <rect x="74"  y="66" width="32" height="148" rx="5" fill="#fff"/>
          <rect x="174" y="66" width="32" height="148" rx="5" fill="#fff"/>
          <polygon points="74,158 206,142 206,150 74,168" fill="#0a3b2e" opacity="0.18"/>
          <polygon points="74,128 206,112 206,140 74,156" fill="url(#ll)"/>
          <polygon points="74,128 206,112 206,116 74,132" fill="#ffffff" opacity="0.35"/>
        </svg>

        <!-- Wordmark -->
        <div style="display:flex; align-items:baseline;">
          <span style="font-family:'Inter',-apple-system,sans-serif; font-weight:600; font-size:32px; letter-spacing:-0.045em; color:#f5f5f7; line-height:1;">hatches</span>
          <span style="width:6px; height:6px; border-radius:50%; background:linear-gradient(135deg,#7CE3B3,#1e8e74); margin-left:3px; margin-bottom:4px; align-self:flex-end; box-shadow:0 0 14px rgba(60,199,154,0.7); display:inline-block;"></span>
        </div>
      </div>

      <!-- Form card -->
      <div style="background:rgba(24,24,27,0.8); border:1px solid rgba(255,255,255,0.08); border-radius:18px; padding:32px 28px; backdrop-filter:blur(20px) saturate(180%); -webkit-backdrop-filter:blur(20px) saturate(180%); box-shadow:0 8px 32px rgba(0,0,0,0.4);">
        <form id="form" style="display:flex; flex-direction:column; gap:14px;">
          <input id="username" type="text" placeholder="Benutzername oder E-Mail" required
            style="background:#1c1f23; border:1px solid rgba(255,255,255,0.10); color:#f4f4f5; border-radius:11px; padding:13px 16px; font-size:15px; outline:none; transition:border-color 0.15s; font-family:inherit;"
            onfocus="this.style.borderColor='rgba(60,199,154,0.5)'"
            onblur="this.style.borderColor='rgba(255,255,255,0.10)'" />
          <input id="password" type="password" placeholder="Passwort" required
            style="background:#1c1f23; border:1px solid rgba(255,255,255,0.10); color:#f4f4f5; border-radius:11px; padding:13px 16px; font-size:15px; outline:none; transition:border-color 0.15s; font-family:inherit;"
            onfocus="this.style.borderColor='rgba(60,199,154,0.5)'"
            onblur="this.style.borderColor='rgba(255,255,255,0.10)'" />
          <p id="error" style="color:#f87171; font-size:14px; display:none; margin:0;"></p>
          <button type="submit" id="btn"
            style="background:linear-gradient(135deg,#3CC79A,#1e8e74); color:#fff; font-weight:600; font-size:15px; border:none; border-radius:11px; padding:13px; cursor:pointer; transition:opacity 0.15s; letter-spacing:-0.01em; margin-top:4px; font-family:inherit;">
            Anmelden
          </button>
        </form>
      </div>

      <p style="text-align:center; font-size:11px; color:rgba(255,255,255,0.2); margin-top:24px; letter-spacing:0.02em;">
        HATCHES · SELF-HOSTED · v{version}
      </p>
    </div>

    <script define:vars={{ redirect }}>
      const btn = document.getElementById("btn");
      document.getElementById("form")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const err = document.getElementById("error");
        btn.style.opacity = "0.6";
        btn.textContent = "…";
        const res = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            username: document.getElementById("username").value,
            password: document.getElementById("password").value,
          }),
        });
        const data = await res.json();
        if (data.ok) {
          window.location.href = redirect;
        } else {
          btn.style.opacity = "1";
          btn.textContent = "Anmelden";
          err.textContent = data.error;
          err.style.display = "block";
        }
      });
    </script>
  </body>
</html>
